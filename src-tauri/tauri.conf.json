{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxly",
  "version": "0.1.0",
  "identifier": "com.voxly.desktop",
  "build": {
    "devUrl": "https://voxly-vc.vercel.app",
    "frontendDist": "https://voxly-vc.vercel.app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Voxly",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Talk with your people",
    "longDescription": "Voxly brings messages, groups, and calls together in one desktop app.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
