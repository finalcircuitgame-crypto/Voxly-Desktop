{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxly",
  "version": "0.1.2",
  "identifier": "com.voxly.desktop",
  "build": {
    "devUrl": "https://voxly-vc.vercel.app",
    "frontendDist": "https://voxly-vc.vercel.app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Voxly",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Talk with your people",
    "longDescription": "Voxly brings messages, groups, and calls together in one desktop app.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGODc3RjMzNzQwQzM2MUUKUldRZU5neDBNMytIbjk0MFFUV2NpYzViYWF3N3NQenVTTkpKR2src0pDaTlPM1ByNXA4SjI0NmkK",
      "endpoints": [
        "https://github.com/finalcircuitgame-crypto/Voxly-Desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
